{
  "name": "electrobun-react-tailwind-vite",
  "version": "0.0.1",
  "description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
  "scripts": {
    "start": "electrobun prepare && vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "electrobun prepare && vite --port 5173",
    "preview:mock": "electrobun prepare && vite --config vite.preview.config.ts",
    "bump": "npm version patch --no-git-tag-version",
    "build:canary": "electrobun prepare && vite build && electrobun build --env=canary",
    "build:stable": "electrobun prepare && vite build && electrobun build --env=stable"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.3.0",
    "googleapis": "^186.0.0",
    "lucide-react": "^1.57.0",
    "open": "^11.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electrobun": "2.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
